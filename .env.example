# Copy to .env and load it before running postback-tester (set -a; . ./.env; set +a).
# Never commit the real values.

# Postback secret key for --preset moonetix (Moonetix dashboard, Postback page)
MOONETIX_POSTBACK_KEY=test_postback_key_not_secret

# Secret for --preset custom, or name another variable with --secret-env
POSTBACK_SECRET=

# App ID used for the {app_id} macro of the moonetix preset
MOONETIX_APP_ID=demoapp0000000000000001
